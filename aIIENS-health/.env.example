# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aiiens-health

# ─── JWT & Session ─────────────────────────────────────────────────────────────
# Use 32+ character random strings for secrets
JWT_SECRET="development_access_secret_do_not_use_in_prod_12345"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="development_refresh_secret_do_not_use_in_prod_12345"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="development_cookie_secret_do_not_use_in_prod_12345"

# ─── Security ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Storage (e.g., local | s3 | gcs)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

# AWS S3 (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Payment (e.g., stripe | razorpay — not implemented yet)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
