# ══════════════════════════════════════════════════════════════════════════════
# AIIENS HEALTH — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# PRODUCTION: Inject secrets via a secure secret-management system.
# NEVER commit .env files with real credentials to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/aiiens-health

# ── Authentication (JWT) ─────────────────────────────────────────────────────
# MUST be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Object Storage ───────────────────────────────────────────────────────────
# Options: local, s3
# IMPORTANT: Production MUST use s3. Local storage is for development only.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

# S3-compatible storage (required when STORAGE_PROVIDER=s3)
# Works with AWS S3, MinIO, DigitalOcean Spaces, Backblaze B2
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Payment ──────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=razorpay
RAZORPAY_WEBHOOK_SECRET=

# ── Impact Metrics ───────────────────────────────────────────────────────────
# Options: live (real-time aggregation, cached 5m), precomputed (from ImpactMetric collection)
IMPACT_METRICS_MODE=live

# ── Audit Retention ──────────────────────────────────────────────────────────
# Seconds. Default ≈ 7 years (220752000s) for healthcare compliance.
AUDIT_RETENTION_SECONDS=220752000

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
